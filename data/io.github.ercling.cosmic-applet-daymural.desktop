[Desktop Entry]
# `Name` is the product name and stays untranslated. `Comment` is translated
# here rather than in `i18n/` — the desktop-entry spec has its own
# `Key[locale]` mechanism and the launcher reads this file without running us.
# Locale tags are POSIX-style (`pt_BR`), not the BCP-47 tags used under `i18n/`.
# Machine-generated, like the Fluent catalogues; corrections welcome.
Name=Daymural
Comment=Microsoft Bing's image of the day as your COSMIC wallpaper
Comment[de]=Das Bild des Tages von Microsoft Bing als COSMIC-Hintergrundbild
Comment[es]=La imagen del día de Microsoft Bing como fondo de pantalla de COSMIC
Comment[fr]=L'image du jour de Microsoft Bing comme fond d'écran COSMIC
Comment[it]=L'immagine del giorno di Microsoft Bing come sfondo di COSMIC
Comment[ja]=Microsoft Bing の今日の画像を COSMIC の壁紙に
Comment[ko]=Microsoft Bing의 오늘의 이미지를 COSMIC 배경 화면으로
Comment[pl]=Obraz dnia Microsoft Bing jako tapeta COSMIC
Comment[pt_BR]=A imagem do dia do Microsoft Bing como papel de parede do COSMIC
Comment[ru]=Изображение дня Microsoft Bing в качестве обоев COSMIC
Comment[uk]=Зображення дня Microsoft Bing як фонове зображення COSMIC
Comment[zh_CN]=将 Microsoft Bing 每日图片设为 COSMIC 壁纸
Comment[zh_TW]=將 Microsoft Bing 每日圖片設為 COSMIC 桌布
Type=Application
# Flatpak runs this through the manifest command. `just install` rewrites its
# installed copy to an absolute path because cosmic-panel may not have the
# selected native bindir (for example ~/.local/bin) in PATH.
Exec=daymural
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Bing;Wallpaper;Background;Image;
Icon=io.github.ercling.cosmic-applet-daymural-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-OverflowPriority=10
